{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    "react/exhaustive-deps": "warn",
    "no-unused-vars": ["warn", { "args": "none", "caughtErrors": "none" }]
  }
}
